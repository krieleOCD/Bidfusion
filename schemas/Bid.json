{
  "$defs": {
    "ArtifactReference": {
      "additionalProperties": false,
      "description": "Immutable reference to exact artifact content.",
      "properties": {
        "artifact_id": {
          "pattern": "^ART-\\d{8}-\\d{6,}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "bid_id": {
          "pattern": "^BID-\\d{4}-\\d{6}$",
          "title": "Bid Id",
          "type": "string"
        },
        "run_id": {
          "pattern": "^RUN-\\d{8}-\\d{4,}$",
          "title": "Run Id",
          "type": "string"
        },
        "artifact_type": {
          "$ref": "#/$defs/ArtifactType"
        },
        "schema_version": {
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Schema Version",
          "type": "string"
        },
        "content_ref": {
          "minLength": 1,
          "title": "Content Ref",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Content Hash",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "bid_id",
        "run_id",
        "artifact_type",
        "schema_version",
        "content_ref",
        "content_hash"
      ],
      "title": "ArtifactReference",
      "type": "object"
    },
    "ArtifactType": {
      "description": "Stable artifact kinds represented by Foundation contracts.",
      "enum": [
        "raw_document",
        "ocr_result",
        "canonical_document",
        "extraction_result",
        "normalized_bid_dataset",
        "compliance_matrix",
        "working_package"
      ],
      "title": "ArtifactType",
      "type": "string"
    },
    "BidBusinessState": {
      "description": "Minimal business lifecycle; technical stages live on ``ProcessingRun``.",
      "enum": [
        "QUALIFYING",
        "IN_PROGRESS",
        "SUBMITTED",
        "CLOSED"
      ],
      "title": "BidBusinessState",
      "type": "string"
    },
    "DataClassification": {
      "description": "Data classification, drives handling and data-policy decisions.",
      "enum": [
        "PUBLIC",
        "INTERNAL",
        "CONFIDENTIAL",
        "RESTRICTED"
      ],
      "title": "DataClassification",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "A bid workspace related to one upstream commercial opportunity.",
  "properties": {
    "bid_id": {
      "pattern": "^BID-\\d{4}-\\d{6}$",
      "title": "Bid Id",
      "type": "string"
    },
    "opportunity_id": {
      "pattern": "^OPP-\\d{6,}$",
      "title": "Opportunity Id",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "customer": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Customer"
    },
    "received_at": {
      "format": "date-time",
      "title": "Received At",
      "type": "string"
    },
    "classification": {
      "$ref": "#/$defs/DataClassification",
      "default": "CONFIDENTIAL"
    },
    "business_state": {
      "$ref": "#/$defs/BidBusinessState",
      "default": "QUALIFYING"
    },
    "source_package": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactReference"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "metadata": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Metadata",
      "type": "object"
    }
  },
  "required": [
    "bid_id",
    "opportunity_id",
    "title",
    "received_at"
  ],
  "title": "Bid",
  "type": "object"
}
