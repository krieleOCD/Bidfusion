{
  "$defs": {
    "BoundingBox": {
      "additionalProperties": false,
      "description": "OCR or vision bounding box in the producer's declared coordinate space.",
      "properties": {
        "x": {
          "minimum": 0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "minimum": 0,
          "title": "Y",
          "type": "number"
        },
        "width": {
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "number"
        },
        "height": {
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "number"
        },
        "coordinate_space": {
          "default": "source",
          "description": "Producer-defined space, e.g. \"pixels\", \"points\", or \"normalized\".",
          "title": "Coordinate Space",
          "type": "string"
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "title": "BoundingBox",
      "type": "object"
    },
    "SourceLocator": {
      "additionalProperties": false,
      "description": "Typed location within a source; at least one locator is required.",
      "properties": {
        "whole_document": {
          "default": false,
          "title": "Whole Document",
          "type": "boolean"
        },
        "page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "section_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section Id"
        },
        "block_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Block Id"
        },
        "paragraph_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Paragraph Id"
        },
        "table_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Table Id"
        },
        "row": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Row"
        },
        "column": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Column"
        },
        "cell_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cell Id"
        },
        "text_span": {
          "anyOf": [
            {
              "$ref": "#/$defs/TextSpan"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "bounding_box": {
          "anyOf": [
            {
              "$ref": "#/$defs/BoundingBox"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "SourceLocator",
      "type": "object"
    },
    "TextSpan": {
      "additionalProperties": false,
      "description": "Half-open character range in canonical text.",
      "properties": {
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "exclusiveMinimum": 0,
          "title": "End",
          "type": "integer"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "TextSpan",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Pointer to exact original content and, when available, its canonical block.",
  "properties": {
    "bid_id": {
      "pattern": "^BID-\\d{4}-\\d{6}$",
      "title": "Bid Id",
      "type": "string"
    },
    "document_id": {
      "pattern": "^DOC-\\d{3,}$",
      "title": "Document Id",
      "type": "string"
    },
    "filename": {
      "minLength": 1,
      "title": "Filename",
      "type": "string"
    },
    "document_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Document Hash",
      "type": "string"
    },
    "locator": {
      "$ref": "#/$defs/SourceLocator"
    },
    "canonical_artifact_id": {
      "anyOf": [
        {
          "pattern": "^ART-\\d{8}-\\d{6,}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Canonical Artifact Id"
    },
    "quote": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Quote"
    }
  },
  "required": [
    "bid_id",
    "document_id",
    "filename",
    "document_hash",
    "locator"
  ],
  "title": "SourceReference",
  "type": "object"
}
