{
  "$defs": {
    "ArtifactReference": {
      "additionalProperties": false,
      "description": "Immutable reference to exact artifact content.",
      "properties": {
        "artifact_id": {
          "pattern": "^ART-\\d{8}-\\d{6,}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "bid_id": {
          "pattern": "^BID-\\d{4}-\\d{6}$",
          "title": "Bid Id",
          "type": "string"
        },
        "run_id": {
          "pattern": "^RUN-\\d{8}-\\d{4,}$",
          "title": "Run Id",
          "type": "string"
        },
        "artifact_type": {
          "$ref": "#/$defs/ArtifactType"
        },
        "schema_version": {
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Schema Version",
          "type": "string"
        },
        "content_ref": {
          "minLength": 1,
          "title": "Content Ref",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Content Hash",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "bid_id",
        "run_id",
        "artifact_type",
        "schema_version",
        "content_ref",
        "content_hash"
      ],
      "title": "ArtifactReference",
      "type": "object"
    },
    "ArtifactType": {
      "description": "Stable artifact kinds represented by Foundation contracts.",
      "enum": [
        "raw_document",
        "ocr_result",
        "canonical_document",
        "extraction_result",
        "normalized_bid_dataset",
        "compliance_matrix",
        "working_package",
        "reviewed_working_package",
        "upload_manifest",
        "bid_run_record"
      ],
      "title": "ArtifactType",
      "type": "string"
    },
    "SecurityCheckResult": {
      "additionalProperties": false,
      "description": "One deterministic or provider-backed security check outcome.",
      "properties": {
        "check": {
          "minLength": 1,
          "title": "Check",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/SecurityCheckStatus"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "severity": {
          "anyOf": [
            {
              "$ref": "#/$defs/Severity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "details": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Details",
          "type": "object"
        }
      },
      "required": [
        "check",
        "status",
        "message"
      ],
      "title": "SecurityCheckResult",
      "type": "object"
    },
    "SecurityCheckStatus": {
      "description": "Outcome of one security mechanism, before gate policy is applied.",
      "enum": [
        "PASS",
        "FAIL",
        "ERROR",
        "UNKNOWN",
        "NOT_APPLICABLE"
      ],
      "title": "SecurityCheckStatus",
      "type": "string"
    },
    "Severity": {
      "description": "Generic severity scale used by findings and risks.",
      "enum": [
        "INFO",
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ],
      "title": "Severity",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Deterministic observations bound to exact raw-artifact bytes.\n\nAn assessment is deliberately not a gate decision. Only gate policy may\nturn all required security assessments into a ``SecurityResult``.",
  "properties": {
    "bid_id": {
      "pattern": "^BID-\\d{4}-\\d{6}$",
      "title": "Bid Id",
      "type": "string"
    },
    "document_id": {
      "pattern": "^DOC-\\d{3,}$",
      "title": "Document Id",
      "type": "string"
    },
    "artifact": {
      "$ref": "#/$defs/ArtifactReference"
    },
    "content_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Content Hash",
      "type": "string"
    },
    "scanner": {
      "minLength": 1,
      "title": "Scanner",
      "type": "string"
    },
    "scanner_version": {
      "minLength": 1,
      "title": "Scanner Version",
      "type": "string"
    },
    "assessed_at": {
      "format": "date-time",
      "title": "Assessed At",
      "type": "string"
    },
    "checks": {
      "items": {
        "$ref": "#/$defs/SecurityCheckResult"
      },
      "minItems": 1,
      "title": "Checks",
      "type": "array"
    }
  },
  "required": [
    "bid_id",
    "document_id",
    "artifact",
    "content_hash",
    "scanner",
    "scanner_version",
    "assessed_at",
    "checks"
  ],
  "title": "PreflightAssessment",
  "type": "object"
}
