{
  "$defs": {
    "ArtifactReference": {
      "additionalProperties": false,
      "description": "Immutable reference to exact artifact content.",
      "properties": {
        "artifact_id": {
          "pattern": "^ART-\\d{8}-\\d{6,}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "bid_id": {
          "pattern": "^BID-\\d{4}-\\d{6}$",
          "title": "Bid Id",
          "type": "string"
        },
        "run_id": {
          "pattern": "^RUN-\\d{8}-\\d{4,}$",
          "title": "Run Id",
          "type": "string"
        },
        "artifact_type": {
          "$ref": "#/$defs/ArtifactType"
        },
        "schema_version": {
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Schema Version",
          "type": "string"
        },
        "content_ref": {
          "minLength": 1,
          "title": "Content Ref",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Content Hash",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "bid_id",
        "run_id",
        "artifact_type",
        "schema_version",
        "content_ref",
        "content_hash"
      ],
      "title": "ArtifactReference",
      "type": "object"
    },
    "ArtifactType": {
      "description": "Stable artifact kinds represented by Foundation contracts.",
      "enum": [
        "raw_document",
        "ocr_result",
        "canonical_document",
        "extraction_result",
        "normalized_bid_dataset",
        "compliance_matrix",
        "working_package"
      ],
      "title": "ArtifactType",
      "type": "string"
    },
    "DataClassification": {
      "description": "Data classification, drives handling and data-policy decisions.",
      "enum": [
        "PUBLIC",
        "INTERNAL",
        "CONFIDENTIAL",
        "RESTRICTED"
      ],
      "title": "DataClassification",
      "type": "string"
    },
    "ProcessingStatus": {
      "description": "Processing status of a document or a pipeline step.",
      "enum": [
        "PENDING",
        "IN_PROGRESS",
        "COMPLETED",
        "FAILED",
        "SKIPPED",
        "REQUIRES_REVIEW"
      ],
      "title": "ProcessingStatus",
      "type": "string"
    },
    "SecurityVerdict": {
      "description": "Verdict of the security gate for a single document.\n\nMANUAL_REVIEW is pending until an audited release or rejection exists.\nBLOCK and QUARANTINE never enter the normal pipeline.",
      "enum": [
        "ALLOW",
        "MANUAL_REVIEW",
        "QUARANTINE",
        "BLOCK"
      ],
      "title": "SecurityVerdict",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Inventory record of a received document (Domain C).",
  "properties": {
    "bid_id": {
      "pattern": "^BID-\\d{4}-\\d{6}$",
      "title": "Bid Id",
      "type": "string"
    },
    "document_id": {
      "pattern": "^DOC-\\d{3,}$",
      "title": "Document Id",
      "type": "string"
    },
    "artifact": {
      "$ref": "#/$defs/ArtifactReference"
    },
    "filename": {
      "minLength": 1,
      "title": "Filename",
      "type": "string"
    },
    "file_type": {
      "minLength": 1,
      "title": "File Type",
      "type": "string"
    },
    "mime_type": {
      "minLength": 1,
      "title": "Mime Type",
      "type": "string"
    },
    "hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Hash",
      "type": "string"
    },
    "size": {
      "description": "File size in bytes",
      "minimum": 0,
      "title": "Size",
      "type": "integer"
    },
    "page_count": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Page Count"
    },
    "language": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Language"
    },
    "security_status": {
      "$ref": "#/$defs/SecurityVerdict"
    },
    "classification": {
      "$ref": "#/$defs/DataClassification",
      "default": "CONFIDENTIAL"
    },
    "processing_status": {
      "$ref": "#/$defs/ProcessingStatus",
      "default": "PENDING"
    },
    "parent_document": {
      "anyOf": [
        {
          "pattern": "^DOC-\\d{3,}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Document"
    },
    "version": {
      "default": 1,
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "bid_id",
    "document_id",
    "artifact",
    "filename",
    "file_type",
    "mime_type",
    "hash",
    "size",
    "security_status"
  ],
  "title": "DocumentInventoryEntry",
  "type": "object"
}
