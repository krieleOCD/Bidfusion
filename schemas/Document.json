{
  "$defs": {
    "ArtifactReference": {
      "additionalProperties": false,
      "description": "Immutable reference to exact artifact content.",
      "properties": {
        "artifact_id": {
          "pattern": "^ART-\\d{8}-\\d{6,}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "bid_id": {
          "pattern": "^BID-\\d{4}-\\d{6}$",
          "title": "Bid Id",
          "type": "string"
        },
        "run_id": {
          "pattern": "^RUN-\\d{8}-\\d{4,}$",
          "title": "Run Id",
          "type": "string"
        },
        "artifact_type": {
          "$ref": "#/$defs/ArtifactType"
        },
        "schema_version": {
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Schema Version",
          "type": "string"
        },
        "content_ref": {
          "minLength": 1,
          "title": "Content Ref",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Content Hash",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "bid_id",
        "run_id",
        "artifact_type",
        "schema_version",
        "content_ref",
        "content_hash"
      ],
      "title": "ArtifactReference",
      "type": "object"
    },
    "ArtifactType": {
      "description": "Stable artifact kinds represented by Foundation contracts.",
      "enum": [
        "raw_document",
        "ocr_result",
        "canonical_document",
        "extraction_result",
        "normalized_bid_dataset",
        "compliance_matrix",
        "working_package",
        "reviewed_working_package",
        "upload_manifest",
        "bid_run_record"
      ],
      "title": "ArtifactType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "A raw, immutable file registered with a bid package.",
  "properties": {
    "document_id": {
      "pattern": "^DOC-\\d{3,}$",
      "title": "Document Id",
      "type": "string"
    },
    "bid_id": {
      "pattern": "^BID-\\d{4}-\\d{6}$",
      "title": "Bid Id",
      "type": "string"
    },
    "artifact": {
      "$ref": "#/$defs/ArtifactReference"
    },
    "filename": {
      "minLength": 1,
      "title": "Filename",
      "type": "string"
    },
    "file_type": {
      "description": "Normalized type, e.g. pdf, docx, xlsx",
      "minLength": 1,
      "title": "File Type",
      "type": "string"
    },
    "mime_type": {
      "minLength": 1,
      "title": "Mime Type",
      "type": "string"
    },
    "sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Sha256",
      "type": "string"
    },
    "size_bytes": {
      "minimum": 0,
      "title": "Size Bytes",
      "type": "integer"
    },
    "parent_document_id": {
      "anyOf": [
        {
          "pattern": "^DOC-\\d{3,}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Document Id"
    },
    "version": {
      "default": 1,
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "document_id",
    "bid_id",
    "artifact",
    "filename",
    "file_type",
    "mime_type",
    "sha256",
    "size_bytes"
  ],
  "title": "Document",
  "type": "object"
}
