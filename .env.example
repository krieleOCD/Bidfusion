# BidFusion — example environment configuration.
# Copy this file to `.env` and fill in local values.
# `.env` is gitignored and must NEVER be committed.

# Runtime environment: local | dev | staging | prod
BIDFUSION_ENV=local

# Logging level for local development: DEBUG | INFO | WARNING | ERROR
BIDFUSION_LOG_LEVEL=INFO

# Local artifact storage for intermediate pipeline artifacts (gitignored).
BIDFUSION_ARTIFACTS_ROOT=./data/artifacts

# Internal LLM Gateway (target runtime).
# BidFusion is model-agnostic: business code talks through LLMPort and never
# selects a provider. The reference below is a logical lookup key, not a
# credential.
BIDFUSION_LLM_GATEWAY_URL=
BIDFUSION_LLM_GATEWAY_SECRET_REF=secret://env/BIDFUSION_LLM_GATEWAY_API_KEY

# Temporary direct Anthropic route for explicit synthetic/public tests only.
# Provider/model selection remains inside this adapter and will be replaced by
# the internal gateway route. Never send customer RFP content through this
# direct test route without a separate approved data-egress decision.
BIDFUSION_ANTHROPIC_URL=https://api.anthropic.com/v1/messages
BIDFUSION_ANTHROPIC_MODEL=claude-sonnet-5
BIDFUSION_ANTHROPIC_SECRET_REF=secret://env/BIDFUSION_LLM_API_KEY

# Add the real value only to `.env`; this intentionally stays empty in Git.
BIDFUSION_LLM_API_KEY=
