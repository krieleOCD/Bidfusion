# BidFusion — example environment configuration.
# Copy this file to `.env` and fill in local values.
# `.env` is gitignored and must NEVER be committed.

# Runtime environment: local | dev | staging | prod
BIDFUSION_ENV=local

# Logging level for local development: DEBUG | INFO | WARNING | ERROR
BIDFUSION_LOG_LEVEL=INFO

# Local artifact storage for intermediate pipeline artifacts (gitignored).
BIDFUSION_ARTIFACTS_ROOT=./data/artifacts

# Internal LLM Gateway.
# BidFusion is model-agnostic: business code talks through LLMPort and never
# selects a provider. The reference below is a logical lookup key, not a
# credential. A future adapter may resolve it from a local environment or
# managed secret store. No LLM calls are implemented in Foundation 1.1.
BIDFUSION_LLM_GATEWAY_URL=
BIDFUSION_LLM_GATEWAY_SECRET_REF=secret://env/BIDFUSION_LLM_GATEWAY_API_KEY
