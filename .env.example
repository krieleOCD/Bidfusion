# BidFusion — example environment configuration.
# Copy this file to `.env` and fill in local values.
# `.env` is gitignored and must NEVER be committed.

# Runtime environment: local | dev | staging | prod
BIDFUSION_ENV=local

# Logging level for local development: DEBUG | INFO | WARNING | ERROR
BIDFUSION_LOG_LEVEL=INFO

# Local artifact storage for intermediate pipeline artifacts (gitignored).
BIDFUSION_ARTIFACTS_ROOT=./data/artifacts

# Internal LLM Gateway (target runtime).
# BidFusion is model-agnostic: business code talks through LLMPort and never
# selects a provider. The reference below is a logical lookup key, not a
# credential.
BIDFUSION_LLM_GATEWAY_URL=
BIDFUSION_LLM_GATEWAY_SECRET_REF=secret://env/BIDFUSION_LLM_GATEWAY_API_KEY

# Temporary direct Anthropic route for explicit synthetic/public tests only.
# Provider/model selection remains inside this adapter and will be replaced by
# the internal gateway route. Never send customer RFP content through this
# direct test route without a separate approved data-egress decision.
# BIDFUSION_ANTHROPIC_API_KEY belongs exclusively to this temporary direct
# connectivity adapter. It must never be set to the same real secret value as
# BIDFUSION_LLM_API_KEY below (Orange LLM Proxy) — they are different
# credentials for different destinations.
BIDFUSION_ANTHROPIC_URL=https://api.anthropic.com/v1/messages
BIDFUSION_ANTHROPIC_MODEL=claude-sonnet-5
BIDFUSION_ANTHROPIC_SECRET_REF=secret://env/BIDFUSION_ANTHROPIC_API_KEY

# Add the real value only to `.env`; this intentionally stays empty in Git.
BIDFUSION_ANTHROPIC_API_KEY=

# Orange LLM Proxy Gateway (ADR-0013) — the canonical, long-term BidFusion
# LLM egress. Disabled by default; no network call is possible without an
# explicit BIDFUSION_LLM_ENABLED=true. BIDFUSION_LLM_API_KEY belongs
# exclusively to this gateway and must never be set to the same real secret
# value as BIDFUSION_ANTHROPIC_API_KEY above.
BIDFUSION_LLM_PROVIDER=orange_proxy
BIDFUSION_LLM_BASE_URL=https://llmproxy.ai.orange
BIDFUSION_LLM_API_KEY=
BIDFUSION_LLM_DEFAULT_MODEL=openai/gpt-5.4-mini
BIDFUSION_LLM_TIMEOUT_SECONDS=60
BIDFUSION_LLM_MAX_RETRIES=2
BIDFUSION_LLM_ENABLED=false

# Additional explicit opt-in required to run the standalone, non-pytest
# connectivity script (scripts/check_orange_proxy_connection.py) for real.
# Both this and BIDFUSION_LLM_ENABLED must be true; the normal test suite
# never reads this variable and never opens a socket.
BIDFUSION_RUN_EXTERNAL_GATEWAY_TESTS=false
